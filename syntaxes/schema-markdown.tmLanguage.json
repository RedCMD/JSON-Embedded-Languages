{
	"$schema": "https://raw.githubusercontent.com/RedCMD/TmLanguage-Syntax-Highlighter/main/vscode.tmLanguage.schema.json",
	"comment": "\"markdownDescription\" & \"patternProperties\" inside `*.schema.json`",
	"name": "JSON Embedded Markdown",
	"scopeName": "source.json.markdown",
	"injectionSelector": [
		"L:source.json.embedded .meta.markdownDescription. string.quoted.double.json -(.meta.markdownDescription. meta.structure.dictionary.json) -(.meta.markdownDescription. meta.structure.array.json) -meta.embedded.text.html.markdown -comment",
		"L:source.json.embedded .meta.markdownDeprecationMessage. string.quoted.double.json -(.meta.markdownDeprecationMessage. meta.structure.dictionary.json) -(.meta.markdownDeprecationMessage. meta.structure.array.json) -meta.embedded.text.html.markdown -comment",
		"L:source.json.embedded .meta.markdownEnumDescriptions. meta.structure.array.json string.quoted.double.json -(.meta.markdownEnumDescriptions. meta.structure.dictionary.json) -(.meta.markdownEnumDescriptions. meta.structure.array.json meta.structure.array.json) -meta.embedded.text.html.markdown -comment"
	],
	"patterns": [
		{
			"comment": "https://github.com/microsoft/vscode-textmate/issues/242",
			"include": "text.html.markdown#_pre-load_"
		},
		{ "include": "#markdown" },
		{ "include": "source.json.embedded#stringcontent" }
	],
	"repository": {
		"markdown": {
			"match": "(?<=\"|\\\\[nr])(?>[^\\x00-\\x1F\"\\\\]++|\\\\[^nr])++(?=\"|\\\\[nr])",
			"captures": {
				"0": {
					"name": "meta.embedded.text.html.markdown",
					"patterns": [
						{
							"comment": "Setup \\G anchor for Markdown",
							"begin": "|",
							"end": "(?!)",
							"patterns": [ { "include": "text.html.markdown" } ]
						}
					]
				}
			}
		}
	}
}
