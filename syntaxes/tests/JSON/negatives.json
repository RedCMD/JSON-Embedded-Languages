{
	"comment": [
		"comment",
		"brackets should work"
	],
	"not-string": [
		"not-string",
		"brackets should work"
	],
	"not@regex": [
		"not@regex",
		"brackets should work"
	],
	"not@-comment": [
		"not@comment",
		"brackets should work"
	],
	"embeddedLanguages": {
		"contributes": {
			"grammars": [
				{
					"embeddedLanguages": {
						"meta.embedded.json.textmate.not-scopeName": "json-textmate-regex"
					}
				}
			]
		}
	},
	"unbalancedBracketScopes": {
		"contributes": {
			"grammars": [
				"invalid.illegal.expected-dictionary-separator.not-scopeName"
			]
		}
	},
	"contributes": {
		"grammars": [
			[
				{
					"scopeName": "source.json.not-scopeName"
				}
			]
		],
		"jsonValidation": [
			[
				{
					"fileMatch": "*.tmLanguage.not-glob"
				}
			]
		],
		"regexp": {
			"problemMatchers": [
				{
					"background": {
						"beginsPattern": "not-regex",
						"endsPattern": "not-regex"
					}
				}
			]
		},
		"problemMatchers": [
			{
				"background": {
					"beginsPattern": {
						"string": "not-regex"
					},
					"regexp": "not-regex"
				}
			}
		],
		"configurationDefaults": {
			"editor.tokenColorCustomizations": {
				"textMateRules": [
					{
						"scope": [
							[
								"comment.not-scope"
							]
						]
					}
				]
			}
		},
		"debuggers": [
			{
				"type": "sqlopsExtensionHost",
				"label": "Azure Data Studio Extension Development",
				"program": "./out/src/nodeDebug.js",
				"runtime": "node",
				"configurationSnippets": [
					[
						{
							"label": "%extensionHost.snippet.launch.label%",
							"description": "%extensionHost.snippet.launch.description%",
							"body": {
								"type": "extensionHost",
								"request": "launch",
								"name": "%extensionHost.launch.config.name%",
								"runtimeExecutable": "^\"\\azuredatastudio\"",
								"args": [
									"^\"--extensionDevelopmentPath=\\${workspaceFolder}\""
								],
								"outFiles": [
									"^\"\\${workspaceFolder}/out/**/*.js\"not-glob"
								],
								"preLaunchTask": "npm",
								"timeout": 15000
							}
						}
					]
				]
			}
		]
	},
	"keybindings": {
		"contributes": [
			{
				"when": "not-when"
			}
		]
	},
	"chatParticipants": [
		{
			"commands": {
				"contributes": [
					{
						"when": "not-when"
					}
				]
			}
		}
	],
	"viewsContainers": {
		"contributes": {
			"activitybar": [
				{
					"when": "not-when"
				}
			]
		}
	}
}
