{
	"launch": {
		"inputs": [],
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Launch",
				"type": "node-terminal",
				"request": "launch",
				"command": "npm start",
				"skipFiles": [
					"<node_internals>/**"
				],
				"outFiles": [
					"${workspaceFolder}/out/**/*.js"
				],
				"resolveSourceMapLocations": [
					"${workspaceFolder}/**",
					"!**/node_modules/**"
				]
			}
		]
	},
	"settings": {
		"cSpell.ignorePaths": [
			".git/{info,lfs,logs,refs,objects}/**"
		],
		"editor.tokenColorCustomizations": {
			"textMateRules": [
				{
					"scope": "variable.parameter.attachment.lea",
					"settings": {
						"fontStyle": "bold",
						"foreground": "#CE9178"
					}
				},
				{
					"name": "Koi Playbook Content - Bright Yellow",
					"scope": [
						"comment.string.quoted.triple.playbook.koi",
						"comment.string.quoted.triple.affordance.koi"
					],
					"settings": {
						"foreground": "#F7DF1E"
					}
				}
			]
		},
		"files.associations": {
			"**/.frontmatter/config/*.json": "jsonc",
			"**/*.ASM*{,/*}": "hlasm"
		},
		"files.exclude": {
			"**/.git": false
		},
		"files.readonlyExclude": {
			"**/node_modules/vscode-textmate/**/*": true
		},
		"workbench.editorAssociations": {
			"{hexdiff}:/**/*.*": "hexEditor.hexedit"
		},
		"workbench.localHistory.exclude": {
			"**/*": true
		}
	}
}
