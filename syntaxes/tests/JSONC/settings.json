{
	"$schema": "vscode://schemas/settings/user",
	"chat.editorAssociations": {
		"*.md": "vscode.markdown.preview.editor",
	},
	"cSpell.files": [
		"**/*",
	],
	"cSpell.ignorePaths": [
		"package-lock.json",
		"package.json",
		"node_modules",
		".git/{info,lfs,logs,refs,objects}/**",
		".git/{index,*refs,*HEAD}",
		".vscode",
		".vscode-insiders",
		".vscode-test-web",
		// "**/extensions",
		"UNICODE_PROPERTIES.ts",
		"unicode_property_data.ts",
		"**/vscode-main",
		"**/achieve*.txt"
	],
	"cSpell.ignoreRegExpList": [
		"regexp",
	],
	"cSpell.includeRegExpList": [
		"regexp",
	],
	"cSpell.overrides": [
		{
			"filename": [
				"TODO: glob **/*",
			],
			"patterns": [
				{
					"pattern": [
						"regexp",
					],
				},
			],
		},
		{
			"filename": "TODO: glob **/*",
			"patterns": [
				{
					"pattern": "regexp",
				},
			],
		},
	],
	"cSpell.patterns": [
		{
			"pattern": [
				"regexp",
			],
		},
		{
			"pattern": "regexp",
		},
	],
	"debug.javascript.autoAttachSmartPattern": [
		"${workspaceFolder}/**",
		"!**/node_modules/**",
		"**/$KNOWN_TOOLS$/**",
	],
	"editor.minimap.markSectionHeaderRegex": "\\bMARK:\\s*(?<separator>-?)\\s*(?<label>.*)$",
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			{
				"scope": "variable.parameter.attachment.lea",
				"settings": {
					"fontStyle": "bold",
					"foreground": "#CE9178"
				}
			},
			{
				"scope": "support.type.decorator.validate.lea",
				"settings": {
					"fontStyle": "italic",
					"foreground": "#4682B4"
				}
			},
			{
				"scope": "keyword.operator.parallel-pipe.lea",
				"settings": {
					"foreground": "#DCDCAA"
				}
			},
			{
				"name": "Koi Playbook Content - Bright Yellow",
				"scope": [
					"comment.string.quoted.triple.playbook.koi",
					"comment.string.quoted.triple.affordance.koi"
				],
				"settings": {
					"foreground": "#F7DF1E"
				}
			}
		],
		"[Dark Modern]": {
			"textMateRules": [
				{
					"name": "Markdown italic and bold",
					"scope": [
						"markup.bold markup.italic",
						"markup.italic markup.bold"
					],
					"settings": {
						"fontStyle": "italic bold"
					}
				}
			]
		},
	},
	"explorer.autoRevealExclude": {
		"**/*.source-extension": {
			"when": "$(basename).not-when",
		},
	},
	"files.associations": {
		"__bit_reference": "cpp",
		"__hash_table": "cpp",
		"*.rasi": "css",
		"*.rex": "rexx",
		"*.sublime-snippet": "xml",
		"*.wasm": "wasm",
		"*.Xresources": "xdefaults",
		"**/.frontmatter/config/*.json": "jsonc",
		"**/*.ASM*{,/*}": "hlasm",
		"**/*.ASSEMBLE*{,/*}": "hlasm",
		"**/*.CNTL*{,/*}": "jcl",
		"**/*.COB*{,/*}": "cobol",
		"**/*.COBCOPY*{,/*}": "cobol",
		"**/*.COBOL*{,/*}": "cobol",
		"**/*.COPY*{,/*}": "cobol",
		"**/*.COPYBOOK*{,/*}": "cobol",
		"**/*.DBD*{,/*}": "hlasm",
		"**/*.EXEC*{,/*}": "rexx",
		"**/*.HLA*{,/*}": "hlasm",
		"**/*.HLASM*{,/*}": "hlasm",
		"**/*.INC*{,/*}": "pl1",
		"**/*.INCLUDE*{,/*}": "pl1",
		"**/*.JCL*{,/*}": "jcl",
		"**/*.MACLIB*{,/*}": "hlasm",
		"**/*.MFS*{,/*}": "hlasm",
		"**/*.PCB*{,/*}": "hlasm",
		"**/*.PL1*{,/*}": "pl1",
		"**/*.PLI*{,/*}": "pl1",
		"**/*.PROC*{,/*}": "jcl",
		"**/*.REXX*{,/*}": "rexx",
		"**/*.REXXINC*{,/*}": "rexx",
		"**/frontmatter.json": "jsonc",
		"algorithm": "c",
		"array": "cpp",
		"chrono": "cpp",
		"deghost.h": "c",
		"deque": "cpp"
	},
	"files.exclude": {
		"**/.git": false,
		"desktop.ini": true
	},
	"files.readonlyExclude": {
		"**/node_modules/vscode-textmate/**/*": true
	},
	"files.readonlyInclude": {
		"**/node_modules/vscode-textmate/**/*": true,
	},
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/.hg/store/**": true,
	},
	"git.worktreeIncludeFiles": [
		"**/*",
	],
	"javascript.preferences.autoImportFileExcludePatterns": [
		"**/*",
	],
	"js/ts.preferences.autoImportFileExcludePatterns": [
		"**/*",
	],
	"markdown.updateLinksOnFileMove.include": [
		"**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
		"**/*.{jpg,jpe,jpeg,png,bmp,gif,ico,webp,avif,tiff,svg,mp4}",
	],
	"markdown.validate.ignoredLinks": [
		"/assets/**/*.svg",
	],
	"npm.exclude": [
		"**/*",
	],
	"search.exclude": {
		"**/*.code-search": true,
		"**/bower_components": true,
		"**/node_modules": true,
		"dist": true, // set this to false to include "dist" folder in search results
		"out": true, // set this to false to include "out" folder in search results
	},
	"typescript.preferences.autoImportFileExcludePatterns": [
		"**/*",
	],
	"workbench.editorAssociations": {
		"{hexdiff}:/**/*.*": "hexEditor.hexedit",
		"*.abs": "default",
		"*.dat": "default",
		"*.g1m": "hexEditor.hexedit",
		"*.txt": "default",
		"*.wasm": "default"
	},
	"workbench.localHistory.exclude": {
		"**/*": true
	}
}
